<Window x:Class="Jarvis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Jarvis.App.ViewModels"
        xmlns:controls="clr-namespace:Jarvis.App.Controls"
        xmlns:local="clr-namespace:Jarvis.App"
        Title="JARVIS" Width="1320" Height="890" MinWidth="1080" MinHeight="700"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource WindowBgBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- dusk light -->
        <Ellipse Width="1180" Height="820" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-380,0,0,-420" Fill="{StaticResource WarmGlowBrush}" Opacity="0.85"
                 IsHitTestVisible="False"/>
        <Ellipse Width="980" Height="720" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-300,-260,0" Fill="{StaticResource CoolGlowBrush}" Opacity="0.8"
                 IsHitTestVisible="False"/>
        <Ellipse Width="900" Height="500" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,-260" Fill="{StaticResource WarmGlowBrush}" Opacity="0.28"
                 IsHitTestVisible="False"/>
        <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="36,96,0,0" Fill="{StaticResource WarmGlowBrush}" Opacity="0.34" IsHitTestVisible="False"/>
        <Ellipse Width="1500" Height="900" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,-560" Fill="{StaticResource WarmGlowBrush}" Opacity="0.5" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource VignetteBrush}" IsHitTestVisible="False"/>

        <Border BorderBrush="#16FFFFFF" BorderThickness="1">
            <Grid Margin="30,18,30,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= header ================= -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid Width="30" Height="30">
                            <Ellipse Stroke="#3FFFFFFF" StrokeThickness="1"/>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource WarmBrush}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#E8A57C" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="J A R V I S" Margin="13,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="MARK VII" Style="{StaticResource Caption}" Margin="12,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource HeaderChip}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="{Binding ActivityBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StateLabel}" Margin="8,0,0,0" FontSize="10.5"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource HeaderChip}" Margin="0,0,12,0" VerticalAlignment="Center"
                                ToolTip="Current brain">
                            <TextBlock Text="{Binding ModelName}" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                       MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" ToolTip="Open notes" AutomationProperties.Name="Open notes" Click="OpenNotes_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimise" AutomationProperties.Name="Minimise" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Content="&#xE922;"
                                ToolTip="Maximise" AutomationProperties.Name="Maximise" Click="Maximize_Click"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close to tray" AutomationProperties.Name="Close to tray" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ================= body ================= -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="356"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- left: the hero -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="4,0,10,0">
                            <Grid Height="214">
                                <controls:StatusOrb Width="194" Height="194" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Activity="{Binding Activity}"
                                                    Level="{Binding MicLevel}"/>
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="1" Background="#26FFFFFF" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding StateWord, Converter={StaticResource Spaced}}"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource WarmBrush}"/>
                                <Border Grid.Column="2" Height="1" Background="#26FFFFFF" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>

                            <TextBlock Text="{Binding HeroSubtitle}" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                                       MaxWidth="300" Margin="0,13,0,0" LineHeight="17"/>

                            <!-- session -->
                            <Border Style="{StaticResource GlassCardTight}" Margin="0,18,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="TURNS" Style="{StaticResource MicroLabel}"/>
                                        <TextBlock Text="{Binding Turns}" FontSize="17" FontWeight="Light" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="MESSAGES" Style="{StaticResource MicroLabel}"/>
                                        <TextBlock Text="{Binding Messages}" FontSize="17" FontWeight="Light" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="MODEL" Style="{StaticResource MicroLabel}"/>
                                        <TextBlock Text="{Binding ModelName}" FontSize="11.5" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="150"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="VOICE" Style="{StaticResource MicroLabel}"/>
                                        <TextBlock Text="{Binding TtsEngine}" FontSize="11.5" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="150"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- actions -->
                            <Button Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Talk to JARVIS" Height="50" Margin="0,14,0,0" Click="Talk_Click"
                                    ToolTip="Wake JARVIS and listen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               VerticalAlignment="Center" Foreground="#20140D"/>
                                    <TextBlock Text="Talk to JARVIS" Margin="9,0,0,0" FontWeight="SemiBold"
                                               Foreground="#20140D" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource GhostButton}" AutomationProperties.Name="Stop current task and speech" Height="40" Click="Stop_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="Stop" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" AutomationProperties.Name="Start a new session" Height="40" Click="NewSession_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="New session" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" AutomationProperties.Name="Pause or resume listening" Height="34" Padding="12,0" Margin="0,8,0,0" Click="Pause_Click">
                                <TextBlock FontSize="11.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Pause listening"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Text" Value="Resume listening"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- memory -->
                            <Border Style="{StaticResource GlassCardTight}" Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="MEMORY" Style="{StaticResource MicroLabel}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource IconButton}" AutomationProperties.Name="Refresh memory preview" Width="24" Height="22" FontSize="10"
                                                Content="&#xE72C;" HorizontalAlignment="Right" ToolTip="Refresh"
                                                Click="RefreshMemory_Click"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding MemoryPreview}" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                               MaxHeight="52" TextTrimming="CharacterEllipsis" LineHeight="14"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Open notes" Height="28"
                                            FontSize="10.5" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Click="OpenNotes_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding SystemLine}" Style="{StaticResource MicroLabel}" Margin="2,10,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="2,6,0,0">
                                <Run Text="{Binding Uptime, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ToolCount, Mode=OneWay}"/><Run Text=" tools  ·  "/><Run Text="{Binding HotkeyTalk, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- right: status + conversation -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- status card -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <controls:OrbitGlyph Grid.Column="0" Width="54" Height="54" VerticalAlignment="Center"
                                                         Mode="{Binding Activity}" Glyph="{Binding CardGlyph}"
                                                         Level="{Binding ActivityLevel}"/>

                                    <Border Grid.Column="1" Width="1" Background="#1FFFFFFF" Margin="0,10"
                                            HorizontalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CardTitle}" AutomationProperties.LiveSetting="Polite" FontSize="18.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CardSubtitle}" FontSize="12" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="520" HorizontalAlignment="Left"/>
                                        <controls:ActivityLine Mode="{Binding Activity}" Level="{Binding ActivityLevel}"
                                                               Width="170" Height="5" HorizontalAlignment="Left" Margin="0,9,0,0">
                                            <controls:ActivityLine.Style>
                                                <Style TargetType="controls:ActivityLine">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activity}" Value="idle">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Activity}" Value="done">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:ActivityLine.Style>
                                        </controls:ActivityLine>
                                    </StackPanel>

                                    <Border Grid.Column="3" Width="1" Background="#1FFFFFFF" Margin="0,10"
                                            HorizontalAlignment="Center"/>

                                    <Button Grid.Column="4" Style="{StaticResource CircleButton}" Content="&#xE71A;" AutomationProperties.Name="Stop current task and speech"
                                            VerticalAlignment="Center" Click="Stop_Click" ToolTip="Stop"/>
                                </Grid>

                                <!-- permission -->
                                <Border Margin="0,16,0,0" Padding="14" CornerRadius="16"
                                        Background="#1FEFC08A" BorderBrush="#40EFC08A" BorderThickness="1"
                                        Visibility="{Binding HasPendingQuestion, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="PERMISSION REQUIRED" Style="{StaticResource MicroLabel}"
                                                   Foreground="{StaticResource AmberBrush}"/>
                                        <TextBlock Text="{Binding PendingQuestion}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   FontSize="12.5" Foreground="#F6DDBE" LineHeight="19"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource BaseButton}" Content="Allow" Padding="18,6" FontSize="11"
                                                    Click="Allow_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Deny" Padding="18,6" FontSize="11"
                                                    Margin="8,0,0,0" Click="Deny_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- workers -->
                                <ItemsControl ItemsSource="{Binding Workers}" Margin="0,14,0,0"
                                              Visibility="{Binding HasWorkers, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:WorkerVm}">
                                            <Border Style="{StaticResource HeaderChip}" Margin="0,0,8,8" Padding="10,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding StateLabel}" FontSize="9" Margin="8,0,0,0"
                                                               Foreground="{Binding StateBrush}"/>
                                                    <TextBlock Text="{Binding Elapsed}" FontSize="9" Margin="8,0,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- transcript -->
                        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="22,0,16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="TRANSCRIPT" Style="{StaticResource MicroLabel}" Foreground="{StaticResource TextDimBrush}"/>
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="live" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" AutomationProperties.Name="Clear transcript" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" ToolTip="Clear the transcript" Click="Clear_Click"/>
                                </Grid>

                                <Border Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="#14FFFFFF">
                                    <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Turns}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="TRY" Style="{StaticResource MicroLabel}" HorizontalAlignment="Center"
                                                   Foreground="#5E6B77"/>
                                        <TextBlock Text="“Open Chrome on the left screen.”" FontSize="12" Margin="0,10,0,0"
                                                   Foreground="#77848F" HorizontalAlignment="Center"/>
                                        <TextBlock Text="“What’s on my screen?”" FontSize="12" Margin="0,5,0,0"
                                                   Foreground="#77848F" HorizontalAlignment="Center"/>
                                        <TextBlock Text="“Tidy my desktop.”" FontSize="12" Margin="0,5,0,0"
                                                   Foreground="#77848F" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <ScrollViewer x:Name="TimelineScroll" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Padding="22,18,14,8">
                                        <ItemsControl x:Name="TimelineList" ItemsSource="{Binding Timeline}"
                                                      AutomationProperties.Name="Conversation transcript"
                                                      AutomationProperties.LiveSetting="Polite">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:TimelineItem}">
                                                    <Grid Margin="0,0,0,15">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0" Width="4" Height="4" Fill="{Binding Accent}"
                                                                 VerticalAlignment="Top" Margin="1,7,12,0" Opacity="0.9"/>
                                                        <StackPanel Grid.Column="1">
                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock Text="{Binding Header}" FontSize="8.5" FontWeight="SemiBold"
                                                                           Foreground="{Binding Accent}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding TimeText}" FontSize="8.5" FontFamily="{StaticResource MonoFont}"
                                                                           Foreground="#56636F" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Body}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                                                                        <Setter Property="FontSize" Value="14.5"/>
                                                                        <Setter Property="LineHeight" Value="23"/>
                                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="user">
                                                                                <Setter Property="FontSize" Value="12.5"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="tool">
                                                                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                                                <Setter Property="FontSize" Value="10.5"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="tool-ok">
                                                                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                                                <Setter Property="FontSize" Value="10"/>
                                                                                <Setter Property="Foreground" Value="#66757F"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="tool-err">
                                                                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                                                <Setter Property="FontSize" Value="10"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="system">
                                                                                <Setter Property="FontSize" Value="11.5"/>
                                                                                <Setter Property="Foreground" Value="#7C8A96"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="approval">
                                                                                <Setter Property="FontSize" Value="12.5"/>
                                                                                <Setter Property="Foreground" Value="#F3D2AD"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="error">
                                                                                <Setter Property="FontSize" Value="12.5"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Margin="16,12,16,14">
                                    <Border CornerRadius="30" Background="#6610171F" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Style="{StaticResource CircleButton}" Content="&#xE720;" AutomationProperties.Name="Listen"
                                                    Width="36" Height="36" Click="Talk_Click" ToolTip="Listen"/>

                                            <Grid Grid.Column="1" Margin="8,0">
                                                <TextBox x:Name="Composer" Style="{StaticResource InputBox}" AutomationProperties.Name="Message to JARVIS" MinHeight="38" MaxHeight="120"
                                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                         Background="Transparent" BorderThickness="0" Padding="2,9"
                                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                                         KeyDown="Composer_KeyDown" TextChanged="Composer_TextChanged"/>
                                                <TextBlock x:Name="ComposerHint" Text="Type to JARVIS, or press Ctrl+Alt+J and speak…"
                                                           IsHitTestVisible="False" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Foreground="#5D6A76" FontSize="12.5"/>
                                            </Grid>

                                            <Button Grid.Column="2" Style="{StaticResource WarmCircleButton}" Content="&#xE724;" AutomationProperties.Name="Send"
                                                    Width="36" Height="36" Click="Send_Click" ToolTip="Send"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding VoiceStatus}" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Caption}" FontSize="9.5"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                               MaxWidth="620" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="Enter to send  ·  Shift+Enter for a new line  ·  Esc stops"
                                               Style="{StaticResource Caption}" FontSize="9.5" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= first run ================= -->
        <Grid Background="#D905080C" Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}">
            <Border Width="600" Style="{StaticResource GlassCard}" Padding="34,30,34,28" CornerRadius="30"
                    VerticalAlignment="Center" Background="#F20B1117" BorderBrush="#2EFFFFFF">
                <StackPanel>
                    <Grid Height="108">
                        <controls:StatusOrb Width="104" Height="104" HorizontalAlignment="Center" Activity="idle" Level="0"/>
                    </Grid>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Center"
                               Foreground="{StaticResource WarmBrush}"/>
                    <TextBlock Text="Let me introduce myself." Style="{StaticResource H1}" FontSize="27" TextAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="Voice, Windows control, memory and background workers. Three answers and I am yours."
                               Foreground="{StaticResource TextDimBrush}" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,8,0,0" FontSize="12"/>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="YOUR NAME" Style="{StaticResource MicroLabel}" Margin="0,0,0,7"/>
                            <TextBox Style="{StaticResource InputBox}" AutomationProperties.Name="Your name" Text="{Binding SetupName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="HONORIFIC" Style="{StaticResource MicroLabel}" Margin="0,0,0,7"/>
                            <TextBox Style="{StaticResource InputBox}" AutomationProperties.Name="Honorific" Text="{Binding SetupHonorific, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="CITY" Style="{StaticResource MicroLabel}" Margin="0,0,0,7"/>
                            <TextBox Style="{StaticResource InputBox}" AutomationProperties.Name="City" Text="{Binding SetupCity, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="BRAIN" Style="{StaticResource MicroLabel}" Margin="0,18,0,7"/>
                    <ComboBox Style="{StaticResource InputCombo}" AutomationProperties.Name="AI provider" ItemsSource="{Binding PresetList}"
                              DisplayMemberPath="Label" SelectedValuePath="Id"
                              SelectedValue="{Binding SetupPreset, UpdateSourceTrigger=PropertyChanged}"/>
                    <PasswordBox x:Name="SetupKeyBox" Style="{StaticResource InputPassword}" AutomationProperties.Name="Provider API key" Margin="0,9,0,0"
                                 PasswordChanged="SetupKey_Changed"
                                 ToolTip="Stored encrypted for this Windows user."/>
                    <TextBlock Margin="2,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap">
                        <Run Text="Key looks like "/><Run Text="{Binding ProviderHint, Mode=OneWay}"/><Run Text="  ·  encrypted with Windows DPAPI, never leaves this PC except to your provider."/>
                    </TextBlock>

                    <TextBlock Text="No key? Continue in local mode. Apps, windows, volume, media, timers, screenshots, memory and system reports all work offline."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="17"/>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Begin" Height="44" Click="SaveSetup_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Continue in local mode" Height="44" Click="SkipSetup_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
