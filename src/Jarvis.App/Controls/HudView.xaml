<UserControl x:Class="Jarvis.App.Controls.HudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Jarvis.App.Controls"
             Width="700" Height="170" IsHitTestVisible="False" Opacity="0" FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <Style x:Key="HudGlass" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C4121A22" Offset="0"/>
                        <GradientStop Color="#99101820" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="44"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="38" ShadowDepth="12" Direction="270" Opacity="0.55" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="Pill" Style="{StaticResource HudGlass}" Width="580" Height="88"
                HorizontalAlignment="Center" Padding="18,0,22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:OrbitGlyph x:Name="Glyph" Grid.Column="0" Width="46" Height="46"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <!-- the reference's hairline between the state glyph and the words -->
                <Border Grid.Column="1" Width="1" Background="#24FFFFFF" Margin="13,17" VerticalAlignment="Stretch"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="TitleText" Text="Standing by" FontSize="16" FontWeight="SemiBold"
                               Foreground="#F4F6F8" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DetailText" Text="" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="#A9B4BE" TextTrimming="CharacterEllipsis" MaxWidth="430"
                               HorizontalAlignment="Left"/>
                    <controls:ActivityLine x:Name="Line" Width="168" Height="4" Margin="0,9,0,0"
                                           HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Border x:Name="RuleLeft" Width="36" Height="1" Background="#2EFFFFFF" VerticalAlignment="Center"/>
            <TextBlock x:Name="StateText" Text="I D L E" Margin="12,0" FontSize="8.5" FontWeight="SemiBold"
                       Foreground="#B9C3CC" VerticalAlignment="Center"/>
            <Border x:Name="RuleRight" Width="36" Height="1" Background="#2EFFFFFF" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
